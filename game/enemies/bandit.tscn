[gd_scene format=3]

[ext_resource type="PackedScene" path="res://game/enemies/enemy_base.tscn" id="base"]
[ext_resource type="Texture2D" path="res://art/sprites/Identified Monster Ver.21/Thief.jpg" id="art"]

[ext_resource type="Shader" path="res://game/rendering/shaders/illustration.gdshader" id="ink"]

[sub_resource type="ShaderMaterial" id="EnemyInk"]
resource_local_to_scene = true
shader = ExtResource("ink")
shader_parameter/illustration = ExtResource("art")

[node name="Bandit" instance=ExtResource("base")]
talk_chances = Vector3(0.45, 0.8, 0.1)
talk_greeting = "Steel or words, traveler? Choose carefully."
talk_success = "Keep walking. I never saw you."
talk_failure = "You take me for a fool?"
impact_material = "flesh"
base_health = 2
heavy_chance = 0.3

[node name="Illustration" parent="." index="0"]
material_override = SubResource("EnemyInk")
